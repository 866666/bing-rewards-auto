# ===== 本地配置（含本机触发时间等信息）=====
.rewards_config.json
.workbuddy/

# ===== 运行产物 =====
rewards_daily_log.txt
rewards_daily_done.png
rewards_diag.png
*.png
logs/

# ===== 运行锁（主脚本 PID，仅本机有效）=====
.rewards_running.lock

# ===== Python =====
__pycache__/
*.pyc

# ===== 历史一次性/探测脚本（含本机旧路径，不入库）=====
archive/

# ===== 一次性网络工具 =====
tools/add_github_hosts.bat
# 临时调试/探测脚本（下划线前缀，不留库）
tools/_tmp_*.py
# ===== GitHub 授权 token 临时文件（绝不入库）=====
.gh_token.tmp
tools/.gh_token.tmp
